# sha256 as of 2026-07-15
FROM node:26.5.0-trixie@sha256:0473e7dc433a1310f436edee02aa79737ec78a4b345433ab0963d4a256f9ad85 AS node-assets

# Install gulp globally so it can be used during builds
RUN npm install --global gulp-cli

COPY ./ /src-files
RUN cd /src-files && ( npm install && npm run build )

LABEL MAINTAINER="Freedom of the Press Foundation"
LABEL APP="securedrop.org"

# Stage 2: Poetry Builder
# sha256 for python:3.14.6-slim-trixie on linux/amd64 as of 2026-06-17
FROM python:3.14.6-slim-trixie@sha256:44dd04494ee8f3b538294360e7c4b3acb87c8268e4d0a4828a6500b1eff50061 AS python-builder
RUN apt-get update && apt-get install -y \
    gcc \
    build-essential \
    libffi-dev \
    libssl-dev \
    libpq-dev \
    libxml2-dev \
    libxslt-dev \
    libz-dev \
    python3-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
ENV POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=1 \
    POETRY_VIRTUALENVS_CREATE=1

WORKDIR /django

COPY bootstrap-poetry-requirements.txt ./
RUN python3 -m venv ~/.local/share/poetry && \
  ~/.local/share/poetry/bin/python -m pip install \
    --only-binary=:all: \
    --require-hashes \
    -r bootstrap-poetry-requirements.txt && \
  ln -sf ~/.local/share/poetry/bin/poetry /usr/local/bin/poetry

COPY pyproject.toml poetry.lock ./
# Poetry natively validates cryptographic hashes from poetry.lock
RUN poetry install --without dev --no-root

# Stage 3: Final Production Image
FROM python:3.14.6-slim-trixie@sha256:44dd04494ee8f3b538294360e7c4b3acb87c8268e4d0a4828a6500b1eff50061 AS python-base
RUN apt-get update && apt-get install -y \
    curl \
    gcc \
    build-essential \
    git \
    libffi-dev \
    libssl-dev \
    libpq-dev \
    libxml2-dev \
    libxslt-dev \
    libz-dev \
    netcat-traditional \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

COPY devops/docker/django-start.sh /usr/local/bin
RUN chmod +x /usr/local/bin/django-start.sh

ARG USERID
RUN getent passwd "${USERID?USERID must be supplied}" || \
    useradd --create-home --no-log-init --uid "${USERID}" --user-group  gcorn

COPY --from=node-assets /src-files/ /django/
# Unfortunately the chown flag in COPY is not
# available in my docker system version :(
RUN find /django -path /django/node_modules -prune -o -print -exec chown gcorn: '{}' \;

WORKDIR /django
ENV TLDEXTRACT_CACHE="/tmp/python-tldextract"

# --- POETRY INTEGRATION ---
COPY --from=python-builder /django/.venv /django/.venv
# Ensure the virtual environment's executables are preferred over system Python
ENV PATH="/django/.venv/bin:$PATH"
# Ensure directories inside the virtual environment belong to the gcorn user
RUN chown -R gcorn: /django/.venv

# Really not used in production. Needed for mapped named volume
# permission handling https://github.com/docker/compose/issues/3270
RUN mkdir /django-media /django-static /django-logs && \
    chown -R gcorn: /django-media && \
    chown -R gcorn: /django-static && \
    chown -R gcorn: /django-logs

RUN mkdir -p /etc/gunicorn && chown -R gcorn: /etc/gunicorn
COPY devops/docker/gunicorn/gunicorn.py /etc/gunicorn/gunicorn.py

# Create /deploy as root
RUN mkdir /deploy && chown -R gcorn: /deploy

# Create tldextract cache file
RUN mkdir -p /tmp/python-tldextract && chown -R gcorn: /tmp/python-tldextract

EXPOSE 8000
USER ${USERID}

# Update cache file for tldextract python package
RUN tldextract --update

# Inject host Git info as build args so version-file.sh can use them as fallbacks
ARG GIT_COMMIT_SHA
ARG GIT_BRANCH
ARG GIT_TAG
ENV GIT_COMMIT_SHA=${GIT_COMMIT_SHA} \
    GIT_BRANCH=${GIT_BRANCH} \
    GIT_TAG=${GIT_TAG}

RUN /django/devops/scripts/version-file.sh

# since no django env is specified, runs in dev; disable DEBUG
RUN env DJANGO_WHITENOISE=1 DJANGO_DISABLE_DEBUG=1 ./manage.py collectstatic -c --noinput

CMD django-start.sh
