# Stage 1: Build node assets
# sha256 for python:3.14.6-slim-trixie on linux/amd64 as of 2026-06-17
FROM python:3.14.6-slim-trixie@sha256:44dd04494ee8f3b538294360e7c4b3acb87c8268e4d0a4828a6500b1eff50061 AS python-base

RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Stage 2: Export the Poetry lock and assemble a wheelhouse
FROM python-base AS dependency-builder
ENV POETRY_NO_INTERACTION=1

WORKDIR /django

COPY bootstrap-poetry-requirements.txt ./
RUN python3 -m venv ~/.local/share/poetry && \
  ~/.local/share/poetry/bin/python -m pip install \
    --prefer-binary=:all: \
    --require-hashes \
    -r bootstrap-poetry-requirements.txt && \
  ln -sf ~/.local/share/poetry/bin/poetry /usr/local/bin/poetry

COPY pyproject.toml poetry.lock ./
# Match `poetry install --no-root`: include all non-optional dependency groups.
# BuildKit transfers only wheels and the hashed export to the final stage.
RUN poetry export \
      --format=requirements.txt \
      --output=/tmp/requirements.txt \
      --all-groups && \
    python3 -m pip wheel \
      --no-cache-dir \
      --require-hashes \
      --no-deps \
      --wheel-dir=/wheels \
      -r /tmp/requirements.txt && \
    find /wheels -maxdepth 1 -type f -name '*.whl' -print | \
      LC_ALL=C sort | \
      while IFS= read -r wheel; do \
        printf '%s --hash=sha256:%s\n' \
          "$wheel" \
          "$(sha256sum "$wheel" | cut -d' ' -f1)"; \
      done > /tmp/wheel-requirements.txt

# Stage 3: Final Development Image
FROM python-base
RUN apt-get update && apt-get install -y --no-install-recommends  \
    curl \
    build-essential \
    git \
    libffi-dev \
    libxml2-dev \
    libxslt-dev \
    libssl-dev \
    libz-dev \
    netcat-traditional \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

COPY devops/docker/django-start.sh /usr/local/bin
RUN chmod +x /usr/local/bin/django-start.sh

WORKDIR /django
ENV TLDEXTRACT_CACHE="/tmp/python-tldextract" \
    VIRTUAL_ENV="/opt/venv" \
    PATH="/opt/venv/bin:$PATH"

# Create the environment in the filesystem where it will run. Installing from
# the wheelhouse avoids copying a non-portable virtualenv or build artifacts.
COPY --from=dependency-builder /wheels /wheels
COPY --from=dependency-builder /tmp/wheel-requirements.txt /tmp/wheel-requirements.txt
RUN python3 -m venv "${VIRTUAL_ENV}" && \
    "${VIRTUAL_ENV}/bin/python" -m pip install \
        --no-cache-dir \
        --no-index \
        --prefer-binary=:all: \
        --require-hashes \
        --no-deps \
        -r /tmp/wheel-requirements.txt && \
    "${VIRTUAL_ENV}/bin/python" -m pip check && \
    rm -rf /wheels /tmp/wheel-requirements.txt

# Define the user BEFORE manipulating ownership
ARG USERID
RUN getent passwd "${USERID?USERID must be supplied}" || useradd --create-home --no-log-init --uid "${USERID}" --user-group  gcorn

RUN mkdir /django-logs /deploy /tmp/python-tldextract && \
    chown -R gcorn: /django-logs /deploy /tmp/python-tldextract

EXPOSE 8000
USER ${USERID}

RUN tldextract --update
CMD [ "django-start.sh" ]
