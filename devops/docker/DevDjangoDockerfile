# Stage 1: Build node assets
# sha256 for python:3.14.6-slim-trixie on linux/amd64 as of 2026-06-17
FROM python:3.14.6-slim-trixie@sha256:44dd04494ee8f3b538294360e7c4b3acb87c8268e4d0a4828a6500b1eff50061 AS python-base

RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Stage 2: Poetry Builder
FROM python-base AS builder
ENV POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=1 \
    POETRY_VIRTUALENVS_CREATE=1

# MATCHING WORKDIR: Keep this the same as the final stage
WORKDIR /django

RUN pip install --no-cache-dir poetry
# Copy your main Poetry configuration files
COPY pyproject.toml poetry.lock ./
# Install ALL dependencies (including dev groups) but skip local code injection
RUN poetry install --no-root

# Stage 3: Final Development Image
FROM python-base
RUN apt-get update && apt-get install -y --no-install-recommends  \
    curl \
    build-essential \
    git \
    libffi-dev \
    libxml2-dev \
    libxslt-dev \
    libssl-dev \
    libz-dev \
    netcat-traditional \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

COPY devops/docker/django-start.sh /usr/local/bin
RUN chmod +x /usr/local/bin/django-start.sh

WORKDIR /django
ENV TLDEXTRACT_CACHE="/tmp/python-tldextract"

# --- POETRY INTEGRATION ---
# MATCHING PATH COPY: Copying /django/.venv to /django/.venv preserves shebang paths
COPY --from=builder /django/.venv /django/.venv
ENV PATH="/django/.venv/bin:$PATH"

# FIX: Define the user BEFORE manipulating ownership
ARG USERID
RUN getent passwd "${USERID?USERID must be supplied}" || useradd --create-home --no-log-init --uid "${USERID}" --user-group  gcorn

# Grant gcorn ownership of the copied virtual environment for local changes/debugging
RUN chown -R gcorn: /django/.venv

RUN mkdir /django-logs /deploy /tmp/python-tldextract && \
    chown -R gcorn: /django-logs /deploy /tmp/python-tldextract

EXPOSE 8000
USER ${USERID}

RUN tldextract --update
CMD [ "django-start.sh" ]
