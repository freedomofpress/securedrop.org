	"private": true,
	"description": "",
	"main": "webpack.config.js",
	"scripts": {
		"build": "webpack --config-node-env production",
		"start": "webpack watch --config-node-env development --devtool eval-source-map",
		"js-lint": "eslint .",
		"stylelint": "stylelint \"client/**/*.scss\"",
		"test:e2e": "playwright test",
