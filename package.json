		"@eslint/js": "^9.39.5",
		"@playwright/test": "1.63.0",
		"babel-loader": "^10.1.1",
		"eslint": "^9.39.5",
		"eslint-plugin-import": "^2.32.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.9",
		"sass": "^1.105.1",
		"sass-loader": "^17.0.1",
		"stylelint": "^17.16.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"svgo": "4.1.0",
		"webpack": "^5.111.1",
		"webpack-bundle-tracker": "^3.2.4",
		"webpack-cli": "^7.2.3"
	},
