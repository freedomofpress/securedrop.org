		"test:e2e:report": "playwright show-report e2e/playwright-report",
		"test:e2e:codegen": "playwright codegen $E2E_BASE_URL"
	},
	"author": "Harris Lapiroff <harris@littleweaverweb.com>",
	"browserslist": [
		"baseline widely available"
	],
	"devDependencies": {
		"@babel/core": "^8.0.6",
